# --- TakeMyLucky server configuration ---
# Copy to .env and fill in. Only JWT_SECRET is strictly required in production.

# HTTP port the Express server listens on
PORT=3001

# Set to "production" to enforce secrets and serve the built SPA from /dist
NODE_ENV=development

# REQUIRED in production. A long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Absolute or relative path to the SQLite database file
DB_PATH=./data/casino.db

# Starting demo balance granted to every new account (virtual credits)
STARTING_BALANCE=10000

# Comma-separated emails that are auto-granted the admin role on register/login
ADMIN_EMAILS=

# Real-money cashier is OFF by default. Do NOT set this to true until a licensed
# payment provider + KYC/AML flow is wired into server/services/payments.ts and
# your gambling licence permits real-money play in the target jurisdiction.
REAL_MONEY_ENABLED=false
