# --- Trading Journal server configuration ---
# Copy to .env and adjust. Everything has sane defaults; nothing is strictly
# required for local use. In production, set JWT_SECRET (or let the server
# generate and persist one next to the database automatically).

# HTTP port the Express server listens on
PORT=3001

# Set to "production" to serve the built SPA from /dist
NODE_ENV=development

# Signs session cookies. Optional — if unset in production the server generates
# one once and persists it next to the database so logins survive restarts.
# Generate manually with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where data lives. DATA_DIR holds the SQLite DB and uploaded chart images.
# Point this at a persistent disk/volume in production.
DATA_DIR=./data
# DB_PATH=./data/journal.db      # override the DB file path directly if needed
# UPLOADS_DIR=./data/uploads     # override the images directory if needed

# Personal single-user journal: once the owner registers, sign-up is closed.
# Set to "true" only if you want to allow additional accounts on this instance.
OPEN_REGISTRATION=false
