# ─── Loops Trd — змінні середовища (скопіюйте в .env.local; на хостингу — у налаштуваннях проєкту) ───
# NEXT_PUBLIC_* потрапляють у браузер (лише публічні значення!) і «вшиваються» під час збірки.

# Reown (WalletConnect) Project ID — https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Публічна адреса сайту (метадані гаманця)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Необов'язково: власний RPC BSC Testnet для гаманців у браузері (QuickNode/Chainstack). Порожньо — RPC Reown.
NEXT_PUBLIC_BSC_RPC_URL=

# Домен і URL сайту. APP_DOMAIN має точно збігатися з host у браузері (SIWE-перевірка).
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000

# Supabase → Project Settings → Database → Connection string → Session pooler (порт 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# PEM-сертифікат Supabase (Database → SSL Configuration → Download certificate) — для перевірки сервера БД.
# Можна в один рядок з \n замість переносів.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5

# Секрет сесій (≥ 32 символи): openssl rand -base64 48
# Використовуйте ОКРЕМИЙ секрет, не JWT secret Supabase (інакше токен сесії дасть прямий доступ до Supabase API).
SESSION_SECRET=

# Лише тестова мережа: BNB Smart Chain Testnet
CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Адреси з loops-trd/contracts/deployments/bscTestnet.json
ESCROW_ADDRESS=
USDT_ADDRESS=
# Пільговий період контракту (cancelGracePeriod), хв — для підказок в інтерфейсі
CANCEL_GRACE_MINUTES=15

# Приватний ключ серверного гаманця антифроду (SIGNER_ROLE + FREEZER_ROLE).
# ОКРЕМИЙ тестовий гаманець з tBNB для газу (approveRelease / freezeDeal / cancel).
BACKEND_SIGNER_PRIVATE_KEY=
# Поріг попередження про нестачу газу, tBNB
LOW_GAS_THRESHOLD=0.02

# Гаманець першого адміністратора: входить без інвайту, лише поки в системі немає жодного адміна.
BOOTSTRAP_ADMIN_WALLET=

# Кіпер (/api/cron/keeper): автоскасування, індексатор подій, звірка з контрактом
CRON_SECRET=
# Для `npm run worker`: інтервал, с
KEEPER_INTERVAL_SEC=30
# Індексатор: скільки блоків назад при першому запуску і розмір кроку
INDEXER_LOOKBACK_BLOCKS=5000
INDEXER_CHUNK_BLOCKS=2000

# IP клієнта: заголовок довіреного проксі (Vercel: x-real-ip; Cloudflare: cf-connecting-ip)
# або кількість довірених проксі перед Next.js (nginx → 1; Cloudflare + nginx → 2).
TRUSTED_IP_HEADER=
TRUST_PROXY_HOPS=1

# Telegram-бот сповіщень (@BotFather). Без токена бот вимкнено.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет webhook (довільний рядок 1–256 символів A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=

# Sentry (необов'язково). Без DSN помилки пишуться лише в логи хостингу.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Антифрод: AMLBot (поки інтеграція-заглушка) або тестові списки для заглушки (через кому)
AMLBOT_API_KEY=
AML_STUB_HIGH_RISK=
AML_STUB_MEDIUM_RISK=
