# ─── Loops Trd — змінні середовища (скопіюйте в .env.local) ───

# Reown (WalletConnect) Project ID — https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Публічна адреса сайту (для метаданих гаманця)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Домен і URL сайту. APP_DOMAIN має точно збігатися з host у браузері (SIWE-перевірка).
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000

# Supabase → Project Settings → Database → Connection string (Session pooler, порт 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Секрет для підпису сесій (≥ 32 символи). Можна використати JWT Secret з Supabase (Legacy JWT secret),
# тоді токен сесії також прийме Supabase PostgREST/Realtime.  openssl rand -base64 48
SESSION_SECRET=

# Лише тестова мережа: BNB Smart Chain Testnet
CHAIN_ID=97
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Адреси з loops-trd/contracts/deployments/bscTestnet.json
ESCROW_ADDRESS=
USDT_ADDRESS=

# Приватний ключ серверного гаманця антифроду (SIGNER_ROLE + FREEZER_ROLE).
# ОКРЕМИЙ тестовий гаманець, на ньому потрібні тестові BNB для газу (approveRelease / freezeDeal / cancel).
BACKEND_SIGNER_PRIVATE_KEY=

# Гаманець першого адміністратора: входить без інвайту, лише поки в системі немає жодного адміна.
BOOTSTRAP_ADMIN_WALLET=

# Секрет для /api/cron/keeper (автоскасування угод без оплати через 30 хв)
CRON_SECRET=

# Антифрод: AMLBot (поки інтеграція-заглушка) або тестові списки для заглушки
AMLBOT_API_KEY=
AML_STUB_HIGH_RISK=
AML_STUB_MEDIUM_RISK=
